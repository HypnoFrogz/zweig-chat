# Nebenan — environment template. Copy to .env and fill in real values.
# Generate strong, unique values before deploying — never reuse these placeholders.

# JWT signing secret (any long random string)
SECRET_KEY=change_me_to_a_long_random_string

# Initial admin account password
ADMIN_PASSWORD=change_me

# LiveKit (must match livekit/livekit.yaml)
LIVEKIT_API_KEY=change_me
LIVEKIT_API_SECRET=change_me

# Web Push (VAPID) — generate a fresh keypair. Without Node, run inside the
# backend container (has `cryptography`):
#   docker compose exec -T backend python - <<'PY'
#   from cryptography.hazmat.primitives.asymmetric import ec
#   from cryptography.hazmat.primitives import serialization
#   import base64
#   b64 = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()
#   k = ec.generate_private_key(ec.SECP256R1())
#   print("VAPID_PUBLIC_KEY=" + b64(k.public_key().public_bytes(
#       serialization.Encoding.X962, serialization.PublicFormat.UncompressedPoint)))
#   print("VAPID_PRIVATE_KEY=" + b64(k.private_numbers().private_value.to_bytes(32, 'big')))
#   PY
VAPID_PUBLIC_KEY=change_me
VAPID_PRIVATE_KEY=change_me
VAPID_EMAIL=mailto:admin@example.com

# Публичный домен ЭТОГО сервера — нужен для федерации (рукопожатие с другими
# серверами). Без него федерация отключена. Например: chat.example.com
SERVER_DOMAIN=chat.example.com

# Разрешить федерацию по plain HTTP — ТОЛЬКО для локальной отладки.
# В проде оставьте пустым: shared_secret уйдёт открытым текстом.
FEDERATION_ALLOW_HTTP=
