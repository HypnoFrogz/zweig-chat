# Настройки обновления для этой машины. Класть в /etc/zweig-update.conf.
# Читается zweig-update.sh — знание о том, как обновляется именно этот сервер,
# живёт здесь, а не в кнопке в браузере.

# Каталог с рабочей копией. У трёх наших установок он разный:
#   ~/nebenan (основной), /opt/zweig (домашний), /opt/zweig-chat (клиентский).
REPO_DIR=/opt/zweig

# Ветка и remote, откуда тянуть.
GIT_REMOTE=origin
GIT_BRANCH=main

# Набор compose-файлов. На центральном сервере их несколько — цепочка -f.
COMPOSE_FILES="-f docker-compose.yml"

# Что пересобирать и поднимать. Через пробел, если служб несколько.
SERVICES="backend"

# Что перезапустить следом, если оно живёт отдельно от нашего compose
# (например, nginx соседнего продукта, который держит тот же порт).
POST_RESTART=""

# Адрес проверки здоровья. Пустой — проверка пропускается, но тогда «обновить»
# означает «сломать удалённо и не узнать об этом».
HEALTH_URL=https://example.com/api/health
HEALTH_TRIES=30
HEALTH_DELAY=3

# Локальные правки, которые есть только на этом сервере (обычно nginx с
# настоящим доменом). Без этого git pull --ff-only на них останавливается,
# и обновление из adm.zweig.services падает. Перед pull файлы возвращаются
# к версии из репозитория, после pull правки накатываются обратно.
#KEEP_LOCAL="nginx/nginx.conf nginx/nginx-ssl.conf"

# Команда после pull (выполняется в REPO_DIR). Если задана — правки
# пересоздаются ею, а не переносятся патчем. Пример для домашнего сервера:
#AFTER_PULL="sed -i 's/chat\.example\.com/nebenan.tech/g' nginx/nginx-ssl.conf && cp nginx/nginx-ssl.conf nginx/nginx.conf"

# Сервер за NAT часто не открывает сам себя по внешнему домену — проверка
# здоровья висит и вызывает откат. Тогда идём на этот адрес, сохраняя домен.
#HEALTH_RESOLVE=127.0.0.1
