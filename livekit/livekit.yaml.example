port: 7880
rtc:
  # Весь медиапоток через один UDP-порт (мультиплексирование). Раньше был
  # диапазон 7882–7892, а LiveKit занимает порт на каждое соединение — на
  # большом звонке 11 портов могло не хватить. Порт 7882 уже открыт в
  # фаерволе и в docker-compose, менять там ничего не нужно.
  udp_port: 7882
  use_external_ip: true
  tcp_port: 7881
turn:
  enabled: true
  # Pin the relay ports so they can be published in docker-compose.yml and
  # opened in the firewall; left unset, TURN picks ephemeral ports that are
  # unreachable from outside the container.
  relay_range_start: 30000
  relay_range_end: 30100
  domain: your-domain.example
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/letsencrypt/live/your-domain.example/fullchain.pem
  key_file: /etc/letsencrypt/live/your-domain.example/privkey.pem
keys:
  # key_name: secret — must match LIVEKIT_API_KEY / LIVEKIT_API_SECRET in .env
  your_api_key: your_livekit_secret
logging:
  level: info
room:
  empty_timeout: 300
  # 0 — без ограничения: потолок задаёт мощность сервера (процессор и
  # канал), а не конфиг. Нужен жёсткий предел — поставьте число.
  max_participants: 0
