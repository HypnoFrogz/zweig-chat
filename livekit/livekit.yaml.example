port: 7880
rtc:
  port_range_start: 7882
  port_range_end: 7892
  use_external_ip: true
  tcp_port: 7881
turn:
  enabled: true
  domain: your-domain.example
  tls_port: 5349
  udp_port: 3478
  cert_file: /etc/letsencrypt/live/your-domain.example/fullchain.pem
  key_file: /etc/letsencrypt/live/your-domain.example/privkey.pem
keys:
  # key_name: secret — must match LIVEKIT_API_KEY / LIVEKIT_API_SECRET in .env
  your_api_key: your_livekit_secret
logging:
  level: info
room:
  empty_timeout: 300
  max_participants: 10
